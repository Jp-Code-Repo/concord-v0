# Copy to .env (scripts/bootstrap.sh does this and fills the blank secrets).
# Never commit .env.

# --- host user (so files created in containers are owned by you) ---
HOST_UID=1000
HOST_GID=1000

# --- app ---
APP_ENV=local
APP_DEBUG=false
# Set to true once the edge serves HTTPS
COOKIE_SECURE=false

# --- datastores ---
MYSQL_ROOT_PASSWORD=
IAM_DB_PASSWORD=
HR_DB_PASSWORD=
REDIS_PASSWORD=

# --- IAM ---
IAM_APP_KEY=
IAM_ADMIN_USERNAME=itadmin
IAM_ADMIN_EMAIL=it@concord.local
IAM_ADMIN_PASSWORD=
